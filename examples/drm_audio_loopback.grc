options:
  parameters:
    author: HenryDelMal
    catch_exceptions: 'True'
    category: '[DRM Examples]'
    cmake_opt: ''
    comment: Experimental DReaM-inspired Opus mode; not part of the ETSI DRM standard.
    copyright: ''
    description: 'Full experimental DRM transmitter and receiver loopback: Opus, MLC,
      OFDM, synchronization, channel decoding, and sound-card playback.'
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: drm_audio_loopback
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: DRM Full Audio Transceiver Loopback
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: tp
  id: variable_drm_config
  parameters:
    RM: '1'
    SO: '3'
    audio_sample_rate: '24000'
    comment: ''
    long_interl: 'False'
    msc_mapping: '1'
    msc_prot_level_2_16: '1'
    msc_prot_level_2_64: '0'
    sdc_mapping: '1'
    station_label: '"gr-drm loopback"'
    text_message: '"Full DRM transmitter and receiver"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 12.0]
    rotation: 0
    state: enabled
- name: audio_encoder
  id: drm_opus_audio_encoder_fb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 216]
    rotation: 0
    state: enabled
- name: blocks_wavfile_source_0
  id: blocks_wavfile_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    file: /Users/henry/ecdc/27f_biobio_24k_mono.wav
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    repeat: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 352.0]
    rotation: 0
    state: enabled
- name: carrier_vector_to_stream
  id: blocks_vector_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: Flatten mapped carriers for the constellation display.
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: tp.ofdm().nfft()
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1456, 504]
    rotation: 0
    state: enabled
- name: cell_mapper
  id: cell_mapping_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1248, 320]
    rotation: 0
    state: enabled
- name: constellation_preview
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: MSC, SDC, FAC, and reference carriers before the IFFT.
    grid: 'True'
    gui_hint: 0,0,1,1
    label1: '"DRM carriers"'
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '0'
    marker2: '0'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: '"DRM Transmit Constellation"'
    nconnections: '1'
    size: '2048'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 504]
    rotation: 0
    state: enabled
- name: cyclic_prefix
  id: digital_ofdm_cyclic_prefixer
  parameters:
    affinity: ''
    alias: ''
    comment: Serialize each IFFT vector and prepend the DRM cyclic prefix.
    cp_len: tp.ofdm().n_cp()
    input_size: tp.ofdm().nfft()
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: '0'
    tagname: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 320]
    rotation: 0
    state: enabled
- name: fac_generator
  id: drm_generate_fac_b
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 368]
    rotation: 0
    state: enabled
- name: fac_mlc
  id: mlc_bc
  parameters:
    affinity: ''
    alias: ''
    channel_type: '"FAC"'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 368]
    rotation: 0
    state: enabled
- name: fac_scrambler
  id: drm_scrambler_bb
  parameters:
    affinity: ''
    alias: ''
    block_len: tp.fac().L()
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 368]
    rotation: 0
    state: enabled
- name: ifft
  id: fft_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: Convert mapped DRM carriers to time-domain OFDM symbols.
    fft_size: tp.ofdm().nfft()
    forward: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    nthreads: '1'
    shift: 'True'
    type: complex
    window: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1456, 320]
    rotation: 0
    state: enabled
- name: msc_interleaver
  id: drm_interleaver_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    depth: drm.INTL_DEPTH_DRM
    interl_seq: tp.msc().cell_interl_seq()
    long_interl: tp.cfg().long_interl()
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 216]
    rotation: 0
    state: enabled
- name: msc_mlc
  id: mlc_bc
  parameters:
    affinity: ''
    alias: ''
    channel_type: '"MSC"'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 216]
    rotation: 0
    state: enabled
- name: msc_scrambler
  id: drm_scrambler_bb
  parameters:
    affinity: ''
    alias: ''
    block_len: tp.msc().L_MUX()
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 216]
    rotation: 0
    state: enabled
- name: programme_tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.05'
    comment: Replace this tone with a 24 kHz mono WAV or audio source.
    freq: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: '24000'
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 216]
    rotation: 0
    state: disabled
- name: rx_auto_receiver
  id: drm_opus_auto_receiver_ccf
  parameters:
    affinity: ''
    alias: ''
    audio_sample_rate: tp.cfg().audio_samp_rate()
    comment: FAC selects MSC/SDC mapping and interleaver depth from received baseband.
    maxoutbuf: '0'
    minoutbuf: '0'
    msc_protection: tp.cfg().msc_prot_level_2()
    rm: tp.cfg().RM()
    so: tp.cfg().SO()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 920.0]
    rotation: 0
    state: enabled
- name: sdc_generator
  id: drm_generate_sdc_b
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 504]
    rotation: 0
    state: enabled
- name: sdc_mlc
  id: mlc_bc
  parameters:
    affinity: ''
    alias: ''
    channel_type: '"SDC"'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tp: tp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 504]
    rotation: 0
    state: enabled
- name: sdc_scrambler
  id: drm_scrambler_bb
  parameters:
    affinity: ''
    alias: ''
    block_len: tp.sdc().L()
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 504]
    rotation: 0
    state: enabled
- name: soundcard_sink
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: Recovered 24 kHz PCM from the full DRM receiver.
    device_name: '""'
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: tp.cfg().audio_samp_rate()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4544, 284.0]
    rotation: 0
    state: enabled

connections:
- [audio_encoder, '0', msc_scrambler, '0']
- [blocks_wavfile_source_0, '0', audio_encoder, '0']
- [carrier_vector_to_stream, '0', constellation_preview, '0']
- [cell_mapper, '0', carrier_vector_to_stream, '0']
- [cell_mapper, '0', ifft, '0']
- [fac_generator, '0', fac_scrambler, '0']
- [fac_mlc, '0', cell_mapper, '2']
- [fac_scrambler, '0', fac_mlc, '0']
- [ifft, '0', cyclic_prefix, '0']
- [msc_interleaver, '0', cell_mapper, '0']
- [msc_mlc, '0', msc_interleaver, '0']
- [msc_scrambler, '0', msc_mlc, '0']
- [sdc_generator, '0', sdc_scrambler, '0']
- [sdc_mlc, '0', cell_mapper, '1']
- [sdc_scrambler, '0', sdc_mlc, '0']
- [cyclic_prefix, '0', rx_auto_receiver, '0']
- [rx_auto_receiver, '0', soundcard_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
