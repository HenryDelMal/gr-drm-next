- [pcm_scale, '0', audio_encoder, '0']
- [programme_tone, '0', pcm_scale, '0']
- [rx_audio_decoder, '0', soundcard_sink, '0']
- [rx_cell_demapper, '0', rx_msc_vector_to_stream, '0']
- [rx_cell_demapper, '1', rx_sdc_vector_to_stream, '0']
- [rx_cell_demapper, '2', rx_fac_vector_to_stream, '0']
- [rx_equalizer, '0', rx_cell_demapper, '0']
